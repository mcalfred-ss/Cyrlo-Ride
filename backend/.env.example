# Copy to .env for local development. Never commit .env or real secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Application database only (never legacy cyrlo_ride).
DATABASE_URL=postgresql://cyrlo:cyrlo@127.0.0.1:5432/cyrlo_ride_app?schema=public

# Comma-separated browser origins. Mobile apps omit Origin and are allowed.
CORS_ORIGINS=http://localhost:3000

# Development placeholders. Production boot rejects values that contain "change-me" or "development-only".
JWT_ACCESS_SECRET=development-only-access-secret-change-me
JWT_REFRESH_SECRET=development-only-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=15552000
JWT_ISSUER=cyrlo-ride
JWT_AUDIENCE=cyrlo-ride-clients

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HASH_SECRET=development-only-otp-hash-secret-change-me
# Local/dev only. loadEnv rejects OTP_DEV_EXPOSE_CODE=true when NODE_ENV=production (fail-closed).
# Staging/production must keep this false. When true (non-prod), OTP responses may include developmentCode.
OTP_DEV_EXPOSE_CODE=false
# Allowlisted phone:code pairs for App Store / Play review + internal QA (no SMS). See docs/deployment/REVIEW_TEST_ACCOUNTS.md
# OTP_STATIC_LOGINS=+233555010001:246810,+233555010002:246810,+233555010011:246810,+233555010012:246810
OTP_STATIC_LOGINS=
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_RATE_LIMIT_MAX=10

# Milestone 2 — admin RBAC / MFA. Bootstrap secret must be >= 32 chars. Leave empty to disable bootstrap.
ADMIN_BOOTSTRAP_SECRET=development-only-admin-bootstrap-secret-change-me
# 32-byte AES key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ADMIN_INVITE_TTL_SECONDS=259200
ADMIN_MFA_PENDING_TTL_SECONDS=600
ADMIN_RECENT_MFA_SECONDS=900
TOTP_ISSUER=Cyrlo Ride Admin

# Separate from ADMIN_MFA_ENCRYPTION_KEY. 32-byte base64 AES-GCM key for Ghana Card ciphertext.
IDENTITY_ENCRYPTION_KEY=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=
IDENTITY_ENCRYPTION_KEY_VERSION=1

# Object storage — Bunny.net Edge Storage + CDN Token Authentication (preferred).
# Create a private Storage Zone + Pull Zone; enable Advanced Token Authentication on the Pull Zone.
STORAGE_PROVIDER=bunny
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_ACCESS_KEY=
# Hostname from the zone “FTP & HTTP API” panel (e.g. storage.bunnycdn.com, sg.storage.bunnycdn.com).
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
# Pull zone URL, no trailing slash (e.g. https://cyrlo-ride.b-cdn.net).
BUNNY_CDN_BASE_URL=
BUNNY_CDN_TOKEN_KEY=
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=60
# Legacy Cloudflare R2 (optional fallback if STORAGE_PROVIDER is not bunny).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
RIDER_DOC_RETENTION_MONTHS_AFTER_CLOSURE=12

# Required in production. Used for booking-fee and token-purchase webhooks.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Matching offer response timeout (seconds). Required for dispatch and in production boot.
# Product-approved: 20. Do not reuse GPS freshness (30s).
RIDER_OFFER_RESPONSE_TIMEOUT_SECONDS=20

# Leave empty locally to use the development SMS no-op sender.
# Production OTP: SMS_PROVIDER=vynfy with VYNFY_API_KEY + VYNFY_SENDER_ID (never commit).
# Do not confuse SMS_PROVIDER with PUSH_PROVIDER.
# Sender ID may require Vynfy/NCA approval before production use.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=Cyrlo
VYNFY_API_KEY=
VYNFY_SENDER_ID=

# Push — FCM HTTP v1 (Phase 11C). Android + Flutter iOS via Firebase APNs bridge.
# Mount the Google service-account JSON at runtime; never commit private keys.
# PUSH_PROVIDER=fcm
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_FILE=/secure/path/firebase-adminsdk.json
PUSH_PROVIDER=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
# Deprecated legacy server-key bridge only: PUSH_PROVIDER=fcm-legacy
PUSH_API_KEY=

# Notification outbox worker tuning (optional).
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5
NOTIFICATION_OUTBOX_POLL_MS=3000
NOTIFICATION_STALE_PROCESSING_MS=120000

# Legacy placeholders.
MAPS_PROVIDER=
# If set to a Mapbox pk. token, also used as MAPBOX_ACCESS_TOKEN fallback.
MAPS_API_KEY=

# Public Mapbox token (pk.) for Flutter tiles — returned by GET /maps/config.
# Never put an sk. secret here.
MAPBOX_ACCESS_TOKEN=

# Hosted Cyrlo Maps API (server-side only). Never put these in Flutter.
# CYRLO_MAPS_API_KEY is the bearer secret only (not name:secret, not Mapbox).
CYRLO_MAPS_BASE_URL=https://api.cyrlomap.eqostack.com
CYRLO_MAPS_API_KEY=
CYRLO_MAPS_TIMEOUT_MS=10000

LOG_LEVEL=info
# TRUST_PROXY: false | hop count 1-5 | comma-separated trusted proxy IPs/CIDRs.
# Never set true (would trust arbitrary X-Forwarded-For). Local default: false.
# Production behind a reverse proxy MUST set an explicit hop count (often 1) or CIDRs
# after verifying the VPS Nginx/proxy topology. Bare false is rejected in production
# unless TRUST_PROXY_DIRECT=true (intentional direct exposure, not the usual VPS layout).
TRUST_PROXY=false
TRUST_PROXY_DIRECT=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Isolated from RATE_LIMIT_* — Paystack webhook bursts must not starve the API.
PAYSTACK_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
PAYSTACK_WEBHOOK_RATE_LIMIT_MAX=120
# Isolated rider GPS POST /locations/rider (per authenticated user).
RIDER_GPS_RATE_LIMIT_WINDOW_MS=60000
RIDER_GPS_RATE_LIMIT_MAX=120
