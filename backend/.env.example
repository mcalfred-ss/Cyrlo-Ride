# Copy to .env for local development. Never commit .env or real secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Local PostgreSQL only. Do not expose this port on the public internet.
DATABASE_URL=postgresql://cyrlo:cyrlo@127.0.0.1:5432/cyrlo_ride?schema=public

# Comma-separated browser origins. Mobile apps omit Origin and are allowed.
CORS_ORIGINS=http://localhost:3000

# Development placeholders. Production boot rejects values that contain "change-me" or "development-only".
JWT_ACCESS_SECRET=development-only-access-secret-change-me
JWT_REFRESH_SECRET=development-only-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HASH_SECRET=development-only-otp-hash-secret-change-me

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=Cyrlo

PUSH_PROVIDER=
PUSH_API_KEY=

MAPS_PROVIDER=
MAPS_API_KEY=

LOG_LEVEL=info
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
