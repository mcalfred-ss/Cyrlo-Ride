// Cyrlo Ride uses one PostgreSQL database and one Prisma schema.
// Money is stored in pesewas (GHS 1.00 = 100). Coordinates on API boundaries
// use latitude/longitude. Service-zone polygons use GeoJSON axis order:
// [longitude, latitude].

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Identity ---

enum UserRole {
  PASSENGER
  RIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  LOGIN
  ADMIN_LOGIN
}

/// Staff authority is separate from UserRole. ADMIN on users means "staff account".
/// Permissions come from AdminRoleGrant.staffRole, never from a client-supplied claim alone.
enum StaffRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  phoneNumber String     @unique @map("phone_number")
  role        UserRole
  status      UserStatus @default(ACTIVE)
  displayName String?    @map("display_name")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passengerProfile    PassengerProfile?
  riderProfile        RiderProfile?
  passengerBookings   Booking[]              @relation("PassengerBookings")
  notifications       Notification[]
  notificationOutbox  NotificationOutbox[]
  deviceTokens        DeviceToken[]
  notificationPreference NotificationPreference?
  payments            Payment[]
  auditLogs           AuditLog[]             @relation("AuditActor")
  adminRoleGrants     AdminRoleGrant[]       @relation("AdminGrantSubject")
  adminGrantsIssued   AdminRoleGrant[]       @relation("AdminGrantActor")
  adminInvitationsSent AdminInvitation[]     @relation("AdminInvitationActor")
  adminMfaCredential  AdminMfaCredential?
  adminRecoveryCodes  AdminRecoveryCode[]
  riderReviewDecisions RiderReviewDecision[] @relation("RiderReviewActor")
  serviceZonesCreated  ServiceZone[]         @relation("ServiceZoneCreator")
  serviceZonesUpdated  ServiceZone[]         @relation("ServiceZoneUpdater")
  serviceZonesActivated ServiceZone[]        @relation("ServiceZoneActivator")
  serviceZonesSuspended ServiceZone[]        @relation("ServiceZoneSuspender")
  geoCountriesCreated  Country[]             @relation("GeoCountryCreator")
  geoRegionsCreated    Region[]              @relation("GeoRegionCreator")
  geoDistrictsCreated  District[]            @relation("GeoDistrictCreator")
  geoCommunitiesCreated Community[]          @relation("GeoCommunityCreator")
  riderZoneDecisions   RiderZoneDecision[]   @relation("RiderZoneDecisionActor")
  cancellationRequests BookingCancellationRequest[] @relation("CancellationRequestPassenger")
  disputesSubmitted    Dispute[]             @relation("DisputeSubmitter")
  disputeEvents        DisputeEvent[]        @relation("DisputeEventActor")

  @@map("users")
}

model AdminRoleGrant {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  staffRole StaffRole @map("staff_role")
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation("AdminGrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  granter   User?     @relation("AdminGrantActor", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([staffRole, revokedAt])
  @@map("admin_role_grants")
}

model AdminInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String    @map("phone_number")
  staffRole   StaffRole @map("staff_role")
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  invitedBy   User      @relation("AdminInvitationActor", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([phoneNumber, createdAt])
  @@map("admin_invitations")
}

/// Singleton row (id = 1). Once completedAt is set, bootstrap stays disabled forever.
model AdminBootstrapState {
  id          Int       @id @default(1)
  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by") @db.Uuid

  @@map("admin_bootstrap_state")
}

model AdminMfaCredential {
  userId              String    @id @map("user_id") @db.Uuid
  encryptedTotpSecret String    @map("encrypted_totp_secret")
  enabledAt           DateTime? @map("enabled_at")
  lastUsedStep        BigInt?   @map("last_used_step")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_mfa_credentials")
}

model AdminRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("admin_recovery_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  phoneNumber String     @map("phone_number")
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  expiresAt   DateTime   @map("expires_at")
  attempts    Int        @default(0)
  maxAttempts Int        @map("max_attempts")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([phoneNumber, purpose, createdAt])
  @@map("otp_challenges")
}

enum PassengerGender {
  MALE
  FEMALE
}

model PassengerProfile {
  userId        String           @id @map("user_id") @db.Uuid
  fullName      String?          @map("full_name")
  dateOfBirth   DateTime?        @map("date_of_birth") @db.Date
  gender        PassengerGender?
  homeLocation  String?          @map("home_location")
  homeLatitude  Decimal?         @map("home_latitude") @db.Decimal(9, 6)
  homeLongitude Decimal?         @map("home_longitude") @db.Decimal(9, 6)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passenger_profiles")
}

// --- Riders ---

enum RiderVerificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RiderAvailability {
  OFFLINE
  AVAILABLE
  BUSY
}

enum RiderDocumentKind {
  GHANA_CARD
  RIDER_PHOTO
  VEHICLE_PHOTO
  DRIVERS_LICENCE
  VEHICLE_REGISTRATION
  ROADWORTHINESS
  INSURANCE
}

enum VehicleCategory {
  OKADA
  PRAGYA
  ABOBOYAA
}

enum VehicleVerificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RiderReviewDecisionType {
  APPROVED
  REJECTED
}

model RiderProfile {
  userId               String                   @id @map("user_id") @db.Uuid
  fullName             String                   @map("full_name")
  verificationStatus   RiderVerificationStatus  @default(DRAFT) @map("verification_status")
  availability         RiderAvailability        @default(OFFLINE)
  /// Legacy plaintext column. Must remain null; identity lives in rider_identity_secrets.
  ghanaCardNumber      String?                  @map("ghana_card_number")
  /// Legacy free-text vehicle fields. Prefer rider_vehicles.
  vehicleRegistration  String?                  @map("vehicle_registration")
  vehicleDescription   String?                  @map("vehicle_description")
  verificationNotes    String?                  @map("verification_notes")
  driversLicenceNumber String?                  @map("drivers_licence_number")
  driversLicenceExpiry DateTime?                @map("drivers_licence_expiry")
  submittedAt          DateTime?                @map("submitted_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location             RiderLocation?
  wallet               RiderWallet?
  documents            RiderDocument[]
  vehicles             RiderVehicle[]
  identitySecrets      RiderIdentitySecret[]
  reviewDecisions      RiderReviewDecision[]
  zoneApprovals        RiderZoneApproval[]
  zoneDecisions        RiderZoneDecision[]
  bookings             Booking[]                @relation("RiderBookings")
  offers               BookingOffer[]
  ledgerEntries        TokenLedgerEntry[]
  tokenPurchases       TokenPurchase[]

  @@index([verificationStatus, submittedAt])
  @@map("rider_profiles")
}

model RiderIdentitySecret {
  id         String   @id @default(uuid()) @db.Uuid
  riderId    String   @map("rider_id") @db.Uuid
  purpose    String
  ciphertext String
  keyVersion Int      @map("key_version")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  rider      RiderProfile @relation(fields: [riderId], references: [userId], onDelete: Cascade)

  @@unique([riderId, purpose])
  @@map("rider_identity_secrets")
}

model RiderVehicle {
  id                   String                    @id @default(uuid()) @db.Uuid
  riderId              String                    @map("rider_id") @db.Uuid
  category             VehicleCategory
  registrationNumber   String                    @map("registration_number")
  make                 String
  model                String
  colour               String
  capacity             Int
  verificationStatus   VehicleVerificationStatus @default(DRAFT) @map("verification_status")
  rejectionReason      String?                   @map("rejection_reason")
  submittedAt          DateTime?                 @map("submitted_at")
  reviewedAt           DateTime?                 @map("reviewed_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  rider                RiderProfile              @relation(fields: [riderId], references: [userId], onDelete: Cascade)
  documents            RiderDocument[]
  reviewDecisions      RiderReviewDecision[]

  @@index([riderId, verificationStatus])
  @@index([verificationStatus, submittedAt])
  @@map("rider_vehicles")
}

model RiderDocument {
  id           String            @id @default(uuid()) @db.Uuid
  riderId      String            @map("rider_id") @db.Uuid
  vehicleId    String?           @map("vehicle_id") @db.Uuid
  kind         RiderDocumentKind
  storageKey   String            @map("storage_key")
  contentType  String            @map("content_type")
  sizeBytes    Int               @map("size_bytes")
  checksumSha256 String?         @map("checksum_sha256")
  retainUntil  DateTime?         @map("retain_until")
  replacedAt   DateTime?         @map("replaced_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  rider        RiderProfile      @relation(fields: [riderId], references: [userId], onDelete: Cascade)
  vehicle      RiderVehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([riderId, kind])
  @@index([vehicleId, kind])
  @@map("rider_documents")
}

model RiderReviewDecision {
  id         String                   @id @default(uuid()) @db.Uuid
  riderId    String                   @map("rider_id") @db.Uuid
  vehicleId  String?                  @map("vehicle_id") @db.Uuid
  actorId    String                   @map("actor_id") @db.Uuid
  decision   RiderReviewDecisionType
  reason     String?
  createdAt  DateTime                 @default(now()) @map("created_at")
  rider      RiderProfile             @relation(fields: [riderId], references: [userId], onDelete: Cascade)
  vehicle    RiderVehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  actor      User                     @relation("RiderReviewActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([riderId, createdAt])
  @@index([vehicleId, createdAt])
  @@map("rider_review_decisions")
}

/// Latest operational GPS point per rider. Not a trip trail — see future trip_location_points.
model RiderLocation {
  riderId         String       @id @map("rider_id") @db.Uuid
  latitude        Decimal      @db.Decimal(9, 6)
  longitude       Decimal      @db.Decimal(9, 6)
  accuracyMeters  Decimal?     @map("accuracy_meters") @db.Decimal(8, 2)
  heading         Decimal?     @db.Decimal(5, 2)
  sharingEnabled  Boolean      @default(false) @map("sharing_enabled")
  /// Device-reported GPS time.
  recordedAt      DateTime     @map("recorded_at")
  /// Server time when this point was accepted. Authoritative for freshness.
  receivedAt      DateTime     @map("received_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  rider           RiderProfile @relation(fields: [riderId], references: [userId], onDelete: Cascade)

  @@index([sharingEnabled, recordedAt])
  @@index([sharingEnabled, receivedAt])
  @@map("rider_locations")
}

// --- Nationwide geography + service zones ---

enum GeoEntityStatus {
  ACTIVE
  INACTIVE
}

enum DistrictAdminType {
  DISTRICT
  MUNICIPAL
  METROPOLITAN
  OTHER
}

enum CommunityVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum ServiceZoneStatus {
  DRAFT
  UNDER_REVIEW
  LOCKED
  ACTIVE
  SUSPENDED
}

enum BoundaryVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum RiderZoneApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model Country {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  isoCode     String          @unique @map("iso_code") @db.Char(2)
  status      GeoEntityStatus @default(ACTIVE)
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  regions     Region[]
  createdBy   User?           @relation("GeoCountryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("geo_countries")
}

model Region {
  id          String          @id @default(uuid()) @db.Uuid
  countryId   String          @map("country_id") @db.Uuid
  name        String
  code        String
  status      GeoEntityStatus @default(ACTIVE)
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  country     Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  districts   District[]
  createdBy   User?           @relation("GeoRegionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([countryId, code])
  @@index([countryId, status])
  @@index([name])
  @@map("geo_regions")
}

model District {
  id          String            @id @default(uuid()) @db.Uuid
  regionId    String            @map("region_id") @db.Uuid
  name        String
  code        String
  adminType   DistrictAdminType @default(DISTRICT) @map("admin_type")
  status      GeoEntityStatus   @default(ACTIVE)
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  region      Region            @relation(fields: [regionId], references: [id], onDelete: Restrict)
  communities Community[]
  createdBy   User?             @relation("GeoDistrictCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([regionId, code])
  @@index([regionId, status])
  @@index([name])
  @@map("geo_districts")
}

model Community {
  id                 String                       @id @default(uuid()) @db.Uuid
  districtId         String                       @map("district_id") @db.Uuid
  name               String
  slug               String
  centerLatitude     Decimal?                     @map("center_latitude") @db.Decimal(9, 6)
  centerLongitude    Decimal?                     @map("center_longitude") @db.Decimal(9, 6)
  boundary           Json?
  verificationStatus CommunityVerificationStatus  @default(UNVERIFIED) @map("verification_status")
  status             GeoEntityStatus              @default(ACTIVE)
  createdById        String?                      @map("created_by_id") @db.Uuid
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")
  district           District                     @relation(fields: [districtId], references: [id], onDelete: Restrict)
  serviceZones       ServiceZone[]
  createdBy          User?                        @relation("GeoCommunityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([districtId, slug])
  @@index([districtId, status])
  @@index([name])
  @@map("geo_communities")
}

model ServiceZone {
  id                         String                     @id @default(uuid()) @db.Uuid
  communityId                String?                    @map("community_id") @db.Uuid
  name                       String
  slug                       String?
  description                String?
  /// Denormalized booking gate: true iff status == ACTIVE. Prefer status for admin UX.
  isActive                   Boolean                    @default(false) @map("is_active")
  status                     ServiceZoneStatus          @default(DRAFT)
  boundaryVerificationStatus BoundaryVerificationStatus @default(UNVERIFIED) @map("boundary_verification_status")
  boundary                   Json
  minLatitude                Decimal                    @map("min_latitude") @db.Decimal(9, 6)
  maxLatitude                Decimal                    @map("max_latitude") @db.Decimal(9, 6)
  minLongitude               Decimal                    @map("min_longitude") @db.Decimal(9, 6)
  maxLongitude               Decimal                    @map("max_longitude") @db.Decimal(9, 6)
  activatedAt                DateTime?                  @map("activated_at")
  activatedById              String?                    @map("activated_by_id") @db.Uuid
  suspendedAt                DateTime?                  @map("suspended_at")
  suspendedById              String?                    @map("suspended_by_id") @db.Uuid
  createdById                String?                    @map("created_by_id") @db.Uuid
  updatedById                String?                    @map("updated_by_id") @db.Uuid
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")
  community                  Community?                 @relation(fields: [communityId], references: [id], onDelete: Restrict)
  bookings                   Booking[]
  riderApprovals             RiderZoneApproval[]
  riderDecisions             RiderZoneDecision[]
  createdBy                  User?                      @relation("ServiceZoneCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                  User?                      @relation("ServiceZoneUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  activatedBy                User?                      @relation("ServiceZoneActivator", fields: [activatedById], references: [id], onDelete: SetNull)
  suspendedBy                User?                      @relation("ServiceZoneSuspender", fields: [suspendedById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([status])
  @@index([communityId, status])
  @@index([name])
  @@index([slug])
  @@map("service_zones")
}

/// Current rider↔zone approval state. One row per rider/zone pair.
model RiderZoneApproval {
  id          String                  @id @default(uuid()) @db.Uuid
  riderId     String                  @map("rider_id") @db.Uuid
  zoneId      String                  @map("zone_id") @db.Uuid
  status      RiderZoneApprovalStatus @default(PENDING)
  reason      String?
  decidedAt   DateTime?               @map("decided_at")
  decidedById String?                 @map("decided_by_id") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  rider       RiderProfile            @relation(fields: [riderId], references: [userId], onDelete: Cascade)
  zone        ServiceZone             @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  decisions   RiderZoneDecision[]

  @@unique([riderId, zoneId])
  @@index([zoneId, status])
  @@index([riderId, status])
  @@map("rider_zone_approvals")
}

/// Append-only history of rider-zone decisions. Survives zone deactivation.
model RiderZoneDecision {
  id         String                  @id @default(uuid()) @db.Uuid
  approvalId String                  @map("approval_id") @db.Uuid
  riderId    String                  @map("rider_id") @db.Uuid
  zoneId     String                  @map("zone_id") @db.Uuid
  actorId    String                  @map("actor_id") @db.Uuid
  status     RiderZoneApprovalStatus
  reason     String?
  createdAt  DateTime                @default(now()) @map("created_at")
  approval   RiderZoneApproval       @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  rider      RiderProfile            @relation(fields: [riderId], references: [userId], onDelete: Cascade)
  zone       ServiceZone             @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  actor      User                    @relation("RiderZoneDecisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([riderId, createdAt])
  @@index([zoneId, createdAt])
  @@index([approvalId, createdAt])
  @@map("rider_zone_decisions")
}

// --- Bookings ---

enum BookingStatus {
  AWAITING_PAYMENT
  PAYMENT_FAILED
  SEARCHING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

enum BookingOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  /// Rider did not respond before the configured offer response deadline.
  TIMED_OUT
  /// Offer withdrawn because another rider won, search expired, or booking left SEARCHING.
  INVALIDATED
  /// Legacy / search-side expiry alias kept for existing rows; new code prefers TIMED_OUT or INVALIDATED.
  EXPIRED
  CANCELLED
}

model Booking {
  id                   String          @id @default(uuid()) @db.Uuid
  passengerId          String          @map("passenger_id") @db.Uuid
  riderId              String?         @map("rider_id") @db.Uuid
  serviceZoneId        String?         @map("service_zone_id") @db.Uuid
  status               BookingStatus   @default(AWAITING_PAYMENT)
  vehicleCategory      VehicleCategory @map("vehicle_category")
  pickupLatitude       Decimal         @map("pickup_latitude") @db.Decimal(9, 6)
  pickupLongitude      Decimal         @map("pickup_longitude") @db.Decimal(9, 6)
  /// Optional / legacy. Destination-free model does not require passenger destination.
  destinationLatitude  Decimal?        @map("destination_latitude") @db.Decimal(9, 6)
  destinationLongitude Decimal?        @map("destination_longitude") @db.Decimal(9, 6)
  pickupLabel          String?         @map("pickup_label")
  destinationLabel     String?         @map("destination_label")
  /// Fixed GH₵1 connection fee (pesewas). Not a transport fare.
  bookingFeePesewas    Int             @default(100) @map("booking_fee_pesewas")
  /// Set when the GH₵1 connection fee checkout is initiated (after rider accept).
  /// Null while searching before acceptance under the destination-free model.
  paymentExpiresAt     DateTime?       @map("payment_expires_at")
  /// Set when entering SEARCHING. Matching uses this for search timeout.
  searchExpiresAt      DateTime?       @map("search_expires_at")
  requestedAt          DateTime        @default(now()) @map("requested_at")
  acceptedAt           DateTime?       @map("accepted_at")
  /// Set when assigned rider starts the trip (ACCEPTED → IN_PROGRESS).
  startedAt            DateTime?       @map("started_at")
  cancelledAt          DateTime?       @map("cancelled_at")
  completedAt          DateTime?       @map("completed_at")
  /// Passenger completion acknowledgement time. Not a booking status.
  passengerAcknowledgedAt DateTime?    @map("passenger_acknowledged_at")
  expiredAt            DateTime?       @map("expired_at")
  cancellationReason   String?         @map("cancellation_reason")
  /// PASSENGER | RIDER | ADMIN | SYSTEM — not a booking status.
  cancellationActorType String?        @map("cancellation_actor_type")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  passenger     User                   @relation("PassengerBookings", fields: [passengerId], references: [id])
  rider         RiderProfile?          @relation("RiderBookings", fields: [riderId], references: [userId])
  serviceZone   ServiceZone?           @relation(fields: [serviceZoneId], references: [id])
  offers        BookingOffer[]
  payments      Payment[]
  ledgerEntries TokenLedgerEntry[]
  statusHistory BookingStatusHistory[]
  tripLocations TripLocationPoint[]
  cancellationRequests BookingCancellationRequest[]
  disputes      Dispute[]

  @@index([passengerId, createdAt])
  @@index([riderId, status])
  @@index([status, paymentExpiresAt])
  @@index([status, searchExpiresAt])
  @@index([status, requestedAt])
  @@map("bookings")
}

/// Append-only booking status transitions. Written in the same transaction as the status change.
model BookingStatusHistory {
  id         String        @id @default(uuid()) @db.Uuid
  bookingId  String        @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus @map("to_status")
  actorType  String        @map("actor_type")
  actorId    String?       @map("actor_id") @db.Uuid
  reason     String?
  createdAt  DateTime      @default(now()) @map("created_at")
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

/// Append-only GPS trail for assigned trips (dispute evidence). Not the latest-location row.
model TripLocationPoint {
  id             String   @id @default(uuid()) @db.Uuid
  bookingId      String   @map("booking_id") @db.Uuid
  riderId        String   @map("rider_id") @db.Uuid
  latitude       Decimal  @db.Decimal(9, 6)
  longitude      Decimal  @db.Decimal(9, 6)
  accuracyMeters Decimal? @map("accuracy_meters") @db.Decimal(8, 2)
  heading        Decimal? @db.Decimal(6, 2)
  recordedAt     DateTime @map("recorded_at")
  receivedAt     DateTime @map("received_at")
  createdAt      DateTime @default(now()) @map("created_at")
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, recordedAt])
  @@index([riderId, recordedAt])
  @@map("trip_location_points")
}

enum CancellationRequestStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DECLINED
  ESCALATED
}

enum SupportRecommendation {
  NONE
  REFUND_FEE
  NO_REFUND
  ESCALATE
}

/// Passenger post-acceptance cancellation — support review; no automatic money movement.
model BookingCancellationRequest {
  id               String                     @id @default(uuid()) @db.Uuid
  bookingId        String                     @map("booking_id") @db.Uuid
  passengerId      String                     @map("passenger_id") @db.Uuid
  reason           String
  status           CancellationRequestStatus  @default(OPEN)
  recommendation   SupportRecommendation      @default(NONE)
  recommendedById  String?                    @map("recommended_by_id") @db.Uuid
  resolutionNotes  String?                    @map("resolution_notes")
  refundId         String?                    @map("refund_id") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  resolvedAt       DateTime?                  @map("resolved_at")
  booking          Booking                    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  passenger        User                       @relation("CancellationRequestPassenger", fields: [passengerId], references: [id], onDelete: Restrict)

  @@index([bookingId, status])
  @@index([status, createdAt])
  @@index([passengerId, createdAt])
  @@map("booking_cancellation_requests")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  ESCALATED
}

model Dispute {
  id              String                @id @default(uuid()) @db.Uuid
  bookingId       String                @map("booking_id") @db.Uuid
  submittedById   String                @map("submitted_by_id") @db.Uuid
  submitterRole   String                @map("submitter_role")
  category        String
  description     String
  status          DisputeStatus         @default(OPEN)
  recommendation  SupportRecommendation @default(NONE)
  recommendedById String?               @map("recommended_by_id") @db.Uuid
  resolutionNotes String?               @map("resolution_notes")
  refundId        String?               @map("refund_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  resolvedAt      DateTime?             @map("resolved_at")
  booking         Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  submittedBy     User                  @relation("DisputeSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  events          DisputeEvent[]

  @@index([bookingId, createdAt])
  @@index([status, createdAt])
  @@index([submittedById, createdAt])
  @@map("disputes")
}

model DisputeEvent {
  id        String   @id @default(uuid()) @db.Uuid
  disputeId String   @map("dispute_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  actor     User?    @relation("DisputeEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([disputeId, createdAt])
  @@map("dispute_events")
}

model BookingOffer {
  id            String             @id @default(uuid()) @db.Uuid
  bookingId     String             @map("booking_id") @db.Uuid
  riderId       String             @map("rider_id") @db.Uuid
  status        BookingOfferStatus @default(PENDING)
  batchSequence Int                @map("batch_sequence")
  offeredAt     DateTime           @default(now()) @map("offered_at")
  /// Rider response deadline (configured RIDER_OFFER_RESPONSE_TIMEOUT_SECONDS).
  expiresAt     DateTime           @map("expires_at")
  respondedAt   DateTime?          @map("responded_at")
  booking       Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  rider         RiderProfile       @relation(fields: [riderId], references: [userId], onDelete: Restrict)

  @@unique([bookingId, riderId])
  @@index([riderId, status])
  @@index([bookingId, status])
  @@index([status, expiresAt])
  @@map("booking_offers")
}

// --- Payments and rider tokens ---

enum PaymentPurpose {
  BOOKING_FEE
  TOKEN_PURCHASE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

enum LedgerEntryType {
  PURCHASE
  DEDUCTION
  REFUND
  ADJUSTMENT
}

model Payment {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  bookingId         String?        @map("booking_id") @db.Uuid
  purpose           PaymentPurpose
  amountPesewas     Int            @map("amount_pesewas")
  currency          String         @default("GHS") @db.Char(3)
  status            PaymentStatus  @default(PENDING)
  provider          String         @default("paystack")
  providerReference String?        @unique @map("provider_reference")
  idempotencyKey    String         @unique @map("idempotency_key")
  /// Deprecated for webhook identity; kept nullable for legacy rows. Prefer payment_webhook_events.
  providerEventId   String?        @unique @map("provider_event_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  user              User           @relation(fields: [userId], references: [id])
  booking           Booking?       @relation(fields: [bookingId], references: [id])
  refunds               PaymentRefund[]
  tokenPurchase         TokenPurchase?
  reconciliationCases   FinancialReconciliationCase[]

  @@index([userId, createdAt])
  @@index([bookingId, purpose])
  @@map("payments")
}

/// Server-managed rider token catalog. Prices/quantities are not client-trusted.
model TokenPackage {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  tokenQuantity Int      @map("token_quantity")
  pricePesewas  Int      @map("price_pesewas")
  currency      String   @default("GHS") @db.Char(3)
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  purchases     TokenPurchase[]

  @@index([isActive, displayOrder])
  @@map("token_packages")
}

enum TokenPurchaseStatus {
  PENDING
  PAID
  FAILED
  ABANDONED
}

/// Durable purchase with immutable package snapshot at initiation time.
model TokenPurchase {
  id            String              @id @default(uuid()) @db.Uuid
  riderId       String              @map("rider_id") @db.Uuid
  packageId     String              @map("package_id") @db.Uuid
  paymentId     String              @unique @map("payment_id") @db.Uuid
  packageCode   String              @map("package_code")
  packageName   String              @map("package_name")
  tokenQuantity Int                 @map("token_quantity")
  pricePesewas  Int                 @map("price_pesewas")
  currency      String              @default("GHS") @db.Char(3)
  status        TokenPurchaseStatus @default(PENDING)
  paidAt        DateTime?           @map("paid_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  rider         RiderProfile        @relation(fields: [riderId], references: [userId], onDelete: Restrict)
  package       TokenPackage        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payment       Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([riderId, createdAt])
  @@index([status, createdAt])
  @@index([packageId, createdAt])
  @@map("token_purchases")
}

enum PaymentRefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  /// Provider accepted or crashed mid-flight in a way that cannot be safely auto-retried.
  MANUAL_RECONCILIATION
}

/// Compensating fee refund. Original payment stays SUCCESS.
model PaymentRefund {
  id                  String              @id @default(uuid()) @db.Uuid
  paymentId           String              @map("payment_id") @db.Uuid
  bookingId           String?             @map("booking_id") @db.Uuid
  amountPesewas       Int                 @map("amount_pesewas")
  currency            String              @default("GHS") @db.Char(3)
  status              PaymentRefundStatus @default(REQUESTED)
  reason              String
  idempotencyKey      String              @unique @map("idempotency_key")
  providerRefundId    String?             @unique @map("provider_refund_id")
  attemptNumber       Int                 @default(1) @map("attempt_number")
  maxAttempts         Int                 @default(5) @map("max_attempts")
  requestedById       String?             @map("requested_by_id") @db.Uuid
  reviewedById        String?             @map("reviewed_by_id") @db.Uuid
  /// Set when Finance authorizes execution, or at create for matrix-policy auto-auth.
  /// Worker claim requires this non-null. Support REQUESTED rows leave this null.
  authorizedAt        DateTime?           @map("authorized_at")
  authorizedById      String?             @map("authorized_by_id") @db.Uuid
  failureReason       String?             @map("failure_reason")
  lockedBy            String?             @map("locked_by")
  lockedAt            DateTime?           @map("locked_at")
  nextAttemptAt       DateTime?           @map("next_attempt_at")
  submittedAt         DateTime?           @map("submitted_at")
  confirmedAt         DateTime?           @map("confirmed_at")
  /// Last trusted provider status string (pending/processed/failed/…).
  providerStatus      String?             @map("provider_status")
  reconciliationNote  String?             @map("reconciliation_note")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  payment             Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reconciliationCases FinancialReconciliationCase[]
  reconciliationAttempts RefundReconciliationAttempt[]

  @@index([status, createdAt])
  @@index([bookingId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([status, authorizedAt, nextAttemptAt], map: "payment_refunds_authorized_status_idx")
  @@map("payment_refunds")
}

/// Durable Finance-visible cases (late abandoned charges, refund discrepancies, etc.).
/// status: OPEN | IN_REVIEW | RESOLVED (string for forward-compatible ops tooling).
model FinancialReconciliationCase {
  id                String         @id @default(uuid()) @db.Uuid
  caseType          String         @map("case_type")
  status            String         @default("OPEN")
  paymentId         String?        @map("payment_id") @db.Uuid
  refundId          String?        @map("refund_id") @db.Uuid
  tokenPurchaseId   String?        @map("token_purchase_id") @db.Uuid
  providerReference String?        @map("provider_reference")
  reason            String
  notes             String?
  openedById        String?        @map("opened_by_id") @db.Uuid
  resolvedById      String?        @map("resolved_by_id") @db.Uuid
  resolvedAt        DateTime?      @map("resolved_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  payment           Payment?       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund            PaymentRefund? @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([paymentId, createdAt])
  @@map("financial_reconciliation_cases")
}

model RefundReconciliationAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  refundId       String        @map("refund_id") @db.Uuid
  attemptedAt    DateTime      @default(now()) @map("attempted_at")
  actorId        String?       @map("actor_id") @db.Uuid
  outcome        String
  localStatus    String        @map("local_status")
  providerStatus String?       @map("provider_status")
  notes          String?
  refund         PaymentRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId, attemptedAt])
  @@map("refund_reconciliation_attempts")
}

/// One row per Paystack webhook delivery. Unique on provider event id.
model PaymentWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  providerEventId String    @unique @map("provider_event_id")
  eventType       String    @map("event_type")
  providerReference String? @map("provider_reference")
  payloadHash     String    @map("payload_hash")
  processedAt     DateTime? @map("processed_at")
  processingError String?   @map("processing_error")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([providerReference, createdAt])
  @@map("payment_webhook_events")
}

model RiderWallet {
  riderId      String       @id @map("rider_id") @db.Uuid
  tokenBalance Int          @default(0) @map("token_balance")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  rider        RiderProfile @relation(fields: [riderId], references: [userId], onDelete: Cascade)

  @@map("rider_wallets")
}

model TokenLedgerEntry {
  id              String           @id @default(uuid()) @db.Uuid
  riderId         String           @map("rider_id") @db.Uuid
  bookingId       String?          @map("booking_id") @db.Uuid
  paymentId       String?          @map("payment_id") @db.Uuid
  type            LedgerEntryType
  tokenDelta      Int              @map("token_delta")
  balanceAfter    Int              @map("balance_after")
  idempotencyKey  String           @unique @map("idempotency_key")
  reason          String
  /// Token refunds point at the debit they reverse. Debits leave this null.
  reversesEntryId String?          @map("reverses_entry_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  rider           RiderProfile     @relation(fields: [riderId], references: [userId])
  booking         Booking?         @relation(fields: [bookingId], references: [id])
  reversesEntry   TokenLedgerEntry? @relation("LedgerReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy      TokenLedgerEntry[] @relation("LedgerReversal")

  @@index([riderId, createdAt])
  @@index([bookingId, type])
  @@map("token_ledger_entries")
}

// --- Notifications and audit ---

enum NotificationChannel {
  PUSH
  SMS
  IN_APP
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model Notification {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  channel    NotificationChannel @default(IN_APP)
  eventType  String?             @map("event_type")
  category   String?
  title      String
  body       String
  data       Json?
  entityType String?             @map("entity_type")
  entityId   String?             @map("entity_id")
  outboxId   String?             @unique @map("outbox_id") @db.Uuid
  readAt     DateTime?           @map("read_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox     NotificationOutbox? @relation(fields: [outboxId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, category, createdAt])
  @@map("notifications")
}

/// Transactional outbox. Business TX writes this; workers deliver after commit.
model NotificationOutbox {
  id            String                   @id @default(uuid()) @db.Uuid
  userId        String                   @map("user_id") @db.Uuid
  eventType     String                   @map("event_type")
  category      String
  title         String
  body          String
  data          Json?
  entityType    String?                  @map("entity_type")
  entityId      String?                  @map("entity_id")
  /// Channels to attempt, e.g. ["IN_APP","PUSH"]. OTP SMS is never stored here.
  channels      String[]
  dedupeKey     String?                  @unique @map("dedupe_key")
  status        NotificationOutboxStatus @default(PENDING)
  attemptCount  Int                      @default(0) @map("attempt_count")
  maxAttempts   Int                      @default(5) @map("max_attempts")
  nextAttemptAt DateTime                 @default(now()) @map("next_attempt_at")
  lockedAt      DateTime?                @map("locked_at")
  lockedBy      String?                  @map("locked_by")
  lastError     String?                  @map("last_error")
  completedAt   DateTime?                @map("completed_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries    NotificationDelivery[]
  notification  Notification?

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@map("notification_outbox")
}

model NotificationDelivery {
  id               String                     @id @default(uuid()) @db.Uuid
  outboxId         String                     @map("outbox_id") @db.Uuid
  channel          NotificationChannel
  status           NotificationDeliveryStatus @default(PENDING)
  attemptCount     Int                        @default(0) @map("attempt_count")
  providerCode     String?                    @map("provider_code")
  providerMessage  String?                    @map("provider_message")
  sentAt           DateTime?                  @map("sent_at")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  outbox           NotificationOutbox         @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@unique([outboxId, channel])
  @@index([status, updatedAt])
  @@map("notification_deliveries")
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String
  platform   DevicePlatform
  /// FCM is the transport for Android and typically Flutter iOS via FCM.
  provider   String         @default("FCM")
  isActive   Boolean        @default(true) @map("is_active")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId, isActive])
  @@index([token])
  @@map("device_tokens")
}

/// Optional channel preferences. Cannot disable OTP / critical transactional history.
model NotificationPreference {
  userId              String   @id @map("user_id") @db.Uuid
  pushEnabled         Boolean  @default(true) @map("push_enabled")
  /// Non-critical optional SMS only. OTP and required in-app history ignore this.
  optionalSmsEnabled  Boolean  @default(false) @map("optional_sms_enabled")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
